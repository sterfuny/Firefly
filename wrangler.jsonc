{
  "name": "firefly-blog",
  "main": "./worker/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "blog-content"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "r2-content-build",
        "max_batch_size": 100,
        "max_batch_timeout": 60
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
