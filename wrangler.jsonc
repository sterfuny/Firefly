{
	"name": "firefly-blog",
	"main": "./worker.js"
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist"
	}

	"r2_buckets": [{
		"binding": "MY_BUCKET", // <~ valid JavaScript variable name
		"bucket_name": "blog-content"
	}]

	"queues": {
		"consumers": [
			{
				"queue": "r2-build-queue",
				"max_batch_size": 100, 
				"max_batch_timeout": 60, // 60秒发一次
			}
		]
	}
}
